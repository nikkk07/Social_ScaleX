{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,

    /* @types/node is not installed and is not needed for the build gate.
       The build's type-check runs `tsc --noEmit` against the root config
       (src only); this node project is here for editor tooling and is not
       part of `npm run build`. */
    "types": []
  },
  "include": ["vite.config.ts"]
}
