# ─────────────────────────────────────────────────────────────────────
# Social ScaleX — environment variables. Copy to `.env.local` and fill in.
# `.env.local` is gitignored. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────

# ── Client (browser) — must be NEXT_PUBLIC_-prefixed to reach the bundle.
# Everything with this prefix is PUBLICLY visible in the built JS.
# The Supabase anon key is designed for this and is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Keepalive script + CI (scripts/keep_alive.py, GitHub Actions).
# These are NOT NEXT_PUBLIC_-prefixed and never reach the client bundle.
# Put these in GitHub repository secrets, not in .env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: only if a Python backend is later added on Render.
RENDER_URL=

# ── Server-only (Vercel → Settings → Environment Variables, NOT prefixed).
# Used only by /api/auth/sign-in and /api/crm/* after they verify the caller.
# It bypasses Row Level Security: never prefix it with NEXT_PUBLIC_, never
# commit a real value, and rotate it in Supabase if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# ── Analytics (Vercel → Production only). Nothing loads while these are empty.
# Both are public by design. Format is checked in src/lib/tracking.ts.
# GA4 Measurement ID, e.g. G-ABC123XYZ
NEXT_PUBLIC_GA_ID=
# Meta Pixel ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=

# ── Canonical origin. Everything absolute on the site derives from this:
# canonical tags, OG URLs, JSON-LD @ids, sitemap.xml, robots.txt and llms.txt.
# Leave unset to use https://www.socialscalex.in (the default in src/lib/site.ts).
# Set it (no trailing slash) only if the canonical host ever changes.
NEXT_PUBLIC_SITE_URL=

# ── Self-serve ₹99 comment-to-DM (docs/SELF_SERVE_SETUP.md) ───────────
# Leave empty until Meta approves the app; then set to 1 so the public
# "Get it for ₹99" buttons open /start instead of the enquiry form.
NEXT_PUBLIC_SELF_SERVE_99=
# Google sign-in (Google Cloud → OAuth client ID, type "Web application").
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Instagram app (developers.facebook.com → your app → Instagram → API setup
# with Instagram login → "Instagram app ID" / "Instagram app secret").
IG_APP_ID=
IG_APP_SECRET=
# Any long random string; paste the same value in Meta's webhook settings.
IG_WEBHOOK_VERIFY_TOKEN=
# 32 random bytes, base64: `openssl rand -base64 32`. Never change it later.
IG_TOKEN_KEY=
# Instagram account search (Business Discovery). Runs on Social ScaleX's OWN
# Instagram account through Facebook Login: its Instagram account ID and a
# long-lived Page access token. Empty = search still works, without photos.
IG_LOOKUP_USER_ID=
IG_LOOKUP_TOKEN=
# Optional: Graph API version (default v26.0).
IG_API_VERSION=
# Razorpay → Account & Settings → API keys, and Webhooks → secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: an existing ₹99 monthly plan id; created automatically if empty.
RAZORPAY_PLAN_ID=
# Vercel Cron sends this as a Bearer token: `openssl rand -hex 24`.
CRON_SECRET=
