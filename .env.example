# ─────────────────────────────────────────────────────────────────────
# Social ScaleX — environment variables. Copy to `.env.local` and fill in.
# `.env.local` is gitignored. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────

# ── Client (browser) — must be VITE_-prefixed to reach the bundle.
# Everything with this prefix is PUBLICLY visible in the built JS.
# The Supabase anon key is designed for this and is safe to expose.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Keepalive script + CI (scripts/keep_alive.py, GitHub Actions).
# These are NOT VITE_-prefixed and never reach the client bundle.
# Put these in GitHub repository secrets, not in .env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: only if a Python backend is later added on Render.
RENDER_URL=

# ── NEVER add the Supabase service_role key here or anywhere in the repo.
# It bypasses Row Level Security. It has no place in this project.
