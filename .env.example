# ─────────────────────────────────────────────────────────────────────
# Social ScaleX — environment variables. Copy to `.env.local` and fill in.
# `.env.local` is gitignored. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────

# ── Client (browser) — must be NEXT_PUBLIC_-prefixed to reach the bundle.
# Everything with this prefix is PUBLICLY visible in the built JS.
# The Supabase anon key is designed for this and is safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Keepalive script + CI (scripts/keep_alive.py, GitHub Actions).
# These are NOT NEXT_PUBLIC_-prefixed and never reach the client bundle.
# Put these in GitHub repository secrets, not in .env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: only if a Python backend is later added on Render.
RENDER_URL=

# ── Server-only (Vercel → Settings → Environment Variables, NOT prefixed).
# Used only by /api/auth/sign-in and /api/crm/* after they verify the caller.
# It bypasses Row Level Security: never prefix it with NEXT_PUBLIC_, never
# commit a real value, and rotate it in Supabase if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# ── Analytics (Vercel → Production only). Nothing loads while these are empty.
# Both are public by design. Format is checked in src/lib/tracking.ts.
# GA4 Measurement ID, e.g. G-ABC123XYZ
NEXT_PUBLIC_GA_ID=
# Meta Pixel ID, digits only
NEXT_PUBLIC_META_PIXEL_ID=

# ── Canonical origin. Everything absolute on the site derives from this:
# canonical tags, OG URLs, JSON-LD @ids, sitemap.xml, robots.txt and llms.txt.
# Leave unset to use https://www.socialscalex.in (the default in src/lib/site.ts).
# Set it (no trailing slash) only if the canonical host ever changes.
NEXT_PUBLIC_SITE_URL=
